{
  "name": "@budiauktioner/buildi-primitives",
  "version": "0.3.0",
  "description": "Swedish, EU and international value-object primitives — validation, normalization, masking, and text scanning. TypeScript port of Buildi.Primitives (.NET).",
  "license": "MIT",
  "author": "Budi Auktioner",
  "type": "module",
  "sideEffects": [
    "./dist/esm/index.js",
    "./dist/cjs/index.js",
    "./dist/esm/contact/index.js",
    "./dist/cjs/contact/index.js",
    "./dist/esm/sample-data/index.js",
    "./dist/cjs/sample-data/index.js",
    "./dist/esm/text-scanning/index.js",
    "./dist/cjs/text-scanning/index.js"
  ],
  "types": "./dist/types/index.d.ts",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "PARITY.md",
    "BREAKING_CHANGES.md"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@9.15.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/budiauktioner/buildi-primitives.git"
  },
  "homepage": "https://github.com/budiauktioner/buildi-primitives#readme",
  "bugs": {
    "url": "https://github.com/budiauktioner/buildi-primitives/issues"
  },
  "keywords": [
    "swedish",
    "sweden",
    "eu",
    "iso",
    "validation",
    "normalization",
    "primitives",
    "value-object",
    "personnummer",
    "organisationsnummer",
    "iban",
    "vat",
    "address",
    "phone",
    "country",
    "language"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./contact": {
      "import": {
        "types": "./dist/types/contact/index.d.ts",
        "default": "./dist/esm/contact/index.js"
      },
      "require": {
        "types": "./dist/types/contact/index.d.cts",
        "default": "./dist/cjs/contact/index.js"
      }
    },
    "./measurement": {
      "import": {
        "types": "./dist/types/measurement/index.d.ts",
        "default": "./dist/esm/measurement/index.js"
      },
      "require": {
        "types": "./dist/types/measurement/index.d.cts",
        "default": "./dist/cjs/measurement/index.js"
      }
    },
    "./person": {
      "import": {
        "types": "./dist/types/person/index.d.ts",
        "default": "./dist/esm/person/index.js"
      },
      "require": {
        "types": "./dist/types/person/index.d.cts",
        "default": "./dist/cjs/person/index.js"
      }
    },
    "./organization": {
      "import": {
        "types": "./dist/types/organization/index.d.ts",
        "default": "./dist/esm/organization/index.js"
      },
      "require": {
        "types": "./dist/types/organization/index.d.cts",
        "default": "./dist/cjs/organization/index.js"
      }
    },
    "./geography": {
      "import": {
        "types": "./dist/types/geography/index.d.ts",
        "default": "./dist/esm/geography/index.js"
      },
      "require": {
        "types": "./dist/types/geography/index.d.cts",
        "default": "./dist/cjs/geography/index.js"
      }
    },
    "./validation": {
      "import": {
        "types": "./dist/types/validation/index.d.ts",
        "default": "./dist/esm/validation/index.js"
      },
      "require": {
        "types": "./dist/types/validation/index.d.cts",
        "default": "./dist/cjs/validation/index.js"
      }
    },
    "./text-scanning": {
      "import": {
        "types": "./dist/types/text-scanning/index.d.ts",
        "default": "./dist/esm/text-scanning/index.js"
      },
      "require": {
        "types": "./dist/types/text-scanning/index.d.cts",
        "default": "./dist/cjs/text-scanning/index.js"
      }
    },
    "./sample-data": {
      "import": {
        "types": "./dist/types/sample-data/index.d.ts",
        "default": "./dist/esm/sample-data/index.js"
      },
      "require": {
        "types": "./dist/types/sample-data/index.d.cts",
        "default": "./dist/cjs/sample-data/index.js"
      }
    },
    "./web": {
      "import": {
        "types": "./dist/types/web/index.d.ts",
        "default": "./dist/esm/web/index.js"
      },
      "require": {
        "types": "./dist/types/web/index.d.cts",
        "default": "./dist/cjs/web/index.js"
      }
    },
    "./finance": {
      "import": {
        "types": "./dist/types/finance/index.d.ts",
        "default": "./dist/esm/finance/index.js"
      },
      "require": {
        "types": "./dist/types/finance/index.d.cts",
        "default": "./dist/cjs/finance/index.js"
      }
    },
    "./property": {
      "import": {
        "types": "./dist/types/property/index.d.ts",
        "default": "./dist/esm/property/index.js"
      },
      "require": {
        "types": "./dist/types/property/index.d.cts",
        "default": "./dist/cjs/property/index.js"
      }
    },
    "./banking": {
      "import": {
        "types": "./dist/types/banking/index.d.ts",
        "default": "./dist/esm/banking/index.js"
      },
      "require": {
        "types": "./dist/types/banking/index.d.cts",
        "default": "./dist/cjs/banking/index.js"
      }
    },
    "./vehicle": {
      "import": {
        "types": "./dist/types/vehicle/index.d.ts",
        "default": "./dist/esm/vehicle/index.js"
      },
      "require": {
        "types": "./dist/types/vehicle/index.d.cts",
        "default": "./dist/cjs/vehicle/index.js"
      }
    },
    "./product": {
      "import": {
        "types": "./dist/types/product/index.d.ts",
        "default": "./dist/esm/product/index.js"
      },
      "require": {
        "types": "./dist/types/product/index.d.cts",
        "default": "./dist/cjs/product/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:package": "node scripts/check-package-identity.mjs && tsc -p fixtures/package-types/tsconfig.json",
    "test:package:types": "tsc -p fixtures/package-types/tsconfig.json",
    "release": "pnpm build && pnpm publish --access public",
    "publint": "publint",
    "attw": "attw --pack . --profile node16"
  },
  "pnpm": {
    "overrides": {
      "esbuild@>=0.27.3 <0.28.1": "^0.28.1"
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
}
